###
# Firebase (Client SDK) - Next.js uses NEXT_PUBLIC_* values in the browser.
###
NEXT_PUBLIC_FIREBASE_API_KEY="your_api_key"
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN="your_project_id.firebaseapp.com"
NEXT_PUBLIC_FIREBASE_PROJECT_ID="your_project_id"
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET="your_project_id.appspot.com"
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID="your_sender_id"
NEXT_PUBLIC_FIREBASE_APP_ID="your_app_id"
# NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID="your_measurement_id"

###
# Firebase (Admin SDK) - used on the server to verify ID tokens / session cookies
###
FIREBASE_ADMIN_PROJECT_ID="your_project_id"
FIREBASE_ADMIN_CLIENT_EMAIL="your_service_account_client_email"
# IMPORTANT:
# - keep the value as-is, but replace real newlines with "\n"
#   e.g. "-----BEGIN PRIVATE KEY-----\n....\n-----END PRIVATE KEY-----"
FIREBASE_ADMIN_PRIVATE_KEY="your_service_account_private_key"

